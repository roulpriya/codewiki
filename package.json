{
  "name": "@roulpriya/codewiki",
  "version": "0.1.0",
  "description": "A local, source-cited wiki for GitHub repositories.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roulpriya/codewiki.git"
  },
  "bugs": {
    "url": "https://github.com/roulpriya/codewiki/issues"
  },
  "homepage": "https://github.com/roulpriya/codewiki#readme",
  "keywords": [
    "codewiki",
    "github",
    "wiki",
    "mcp",
    "cli"
  ],
  "bin": {
    "codewiki": "bin/codewiki.mjs"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "cli": "node bin/codewiki.mjs",
    "dev": "bun run scripts/dev.ts",
    "api": "bun run start",
    "mcp": "bun run src/mcp/server.ts",
    "claude": "bun run src/claude/agent.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run src/web.ts",
    "test": "bun run build && bun test ./tests/*.test.mjs",
    "lint": "bun run eslint . --ignore-pattern dist",
    "prepack": "bun run scripts/prepack.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/bun": "^1.4.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "type": "module"
}
