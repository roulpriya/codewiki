{
  "name": "@roulpriya/codewiki",
  "version": "0.1.0",
  "description": "A local, source-cited wiki for GitHub repositories.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roulpriya/codewiki.git"
  },
  "bugs": {
    "url": "https://github.com/roulpriya/codewiki/issues"
  },
  "homepage": "https://github.com/roulpriya/codewiki#readme",
  "keywords": [
    "codewiki",
    "github",
    "wiki",
    "mcp",
    "cli"
  ],
  "bin": {
    "codewiki": "bin/codewiki.mjs"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "src",
    "next.config.ts",
    "postcss.config.mjs",
    "vite.config.ts",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "cli": "node bin/codewiki.mjs",
    "dev": "bunx vinext dev",
    "api": "bun run src/server/index.ts",
    "mcp": "bun run src/mcp/server.ts",
    "claude": "bun run src/claude/agent.ts",
    "build": "bunx vinext build",
    "start": "bunx vinext start",
    "test": "bun run build && bun test tests/*.test.mjs",
    "lint": "bunx eslint . --ignore-pattern dist --ignore-pattern .next",
    "prepack": "bun run scripts/prepack.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-rsc": "^0.5.26",
    "fastify": "^5.12.1",
    "openai": "^7.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "type": "module"
}
